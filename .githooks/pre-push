#!/bin/sh
# Changes come to main only through a pull request: each merge into main makes a release
# (see docs/adr/0001-release-on-each-merge.md). A ruleset on GitHub rejects a push to main.
# This hook stops the push earlier, on this PC, and says what to do instead.
# Turn it on once per clone:
#
#	git config core.hooksPath .githooks
#
# git push --no-verify skips the hook, but GitHub still rejects the push. The Release
# workflow also makes no release from a commit that did not come from a pull request.

while read -r local_ref local_sha remote_ref remote_sha; do
	if [ "$remote_ref" = "refs/heads/main" ]; then
		echo "pre-push: no push to main. Push a branch and merge it with a pull request." >&2
		exit 1
	fi
done
exit 0
